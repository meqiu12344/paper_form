datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  id                    Int      @id @default(autoincrement())
  createdAt             DateTime @default(now())
  name                  String
  email                 String
  phone                 String?
  format                String
  customWidth           String?
  customHeight          String?
  quantity              Int
  material              String
  colorOption           String
  printLengthMultiplier String
  finishes              String?
  totalPrice            Float
  status                String   @default("PENDING")
  fileName              String?
  fileSizeKB            Int?
  filePath              String?
}
